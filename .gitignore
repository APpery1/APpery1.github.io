node_modules/

# 构建产物
dist/
*.tsbuildinfo

# 环境变量与密钥（切勿提交）
.env
.env.local
.env.*.local

# 操作系统产物
.DS_Store
Thumbs.db
desktop.ini

# 编辑器
.vscode/
