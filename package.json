{
  "name": "appery-city",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "snapshot": "node scripts/fetch-repos.mjs",
    "test": "npm run build && node scripts/verify.mjs",
    "test:browser": "node scripts/verify.mjs",
    "test:city": "npm run build && node scripts/verify-city-interactions.mjs && node scripts/verify-city-loading.mjs",
    "format": "prettier --write src vite.config.ts"
  },
  "dependencies": {
    "marked": "^18.0.13",
    "mermaid": "^12.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.2",
    "meshoptimizer": "^1.3.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.2",
    "vite": "^7.1.5"
  }
}
